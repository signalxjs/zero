{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "jsxImportSource": "sigx",
        "esModuleInterop": true,
        // A FULL lib check, since sigx core 1.0 (#145): its shipped
        // declarations pass it (the side-effect `import './jsx-types.d.ts'`
        // that failed TS2882 became a real `.js` module in core's #686), so
        // every dependency d.ts is checked here as well as every source
        // file. The one project that opts back out is `portable/`, which
        // has no lib.dom by design and so cannot lib-check runtime-dom's
        // element table. Phase 3's generator gate compiles the real EMITTED
        // .d.ts with lib checking on, since an app's skipLibCheck would
        // skip it.
        "skipLibCheck": false,
        "forceConsistentCasingInFileNames": true,
        "types": [],
        // Every candidate must reach SOURCE. A subpath that matches none of
        // these falls through to Node resolution, which lands in the stale,
        // gitignored dist/ (or, in CI, resolves to nothing and is silently
        // skipped under skipLibCheck) — the hollow-gate failure #316 closed.
        // Components live at src/components/<scope>/, so the bare `../src/*`
        // wildcard alone cannot reach them. Pinned against package.json
        // exports by __tests__/type-test-paths.test.ts.
        "paths": {
            "@sigx/zero": ["../src/index.ts"],
            "@sigx/zero/*": [
                "../src/components/*/index.ts",
                "../src/*/index.ts",
                "../src/*"
            ]
        }
    }
}
